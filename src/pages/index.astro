---
import Layout from '../layouts/Layout.astro';
const pageTitle = "Rama Krishna's Portfolio";
---

<Layout pageTitle={pageTitle}>
	<div class='gif'>
		<img width='300' height='259' alt='ManWorkingOnLaptop' src='/space.webp' />
	</div>

	<h1>Rama Krishna</h1>
	<span class='badge'>Computer Engineer</span>
	<!-- <span class='badge'>Digital Craftsman</span> -->

	<h2>About</h2>
	<p>Low-level engineer passionate about hardware-accelerated computing.</p>
	<p>
	I work at the hardware-software boundary — programming FPGAs, DPUs, and
    similar platforms to squeeze out performance wherever it's needed most:
    robotics, high-speed networking, LLM inference, and beyond.
	</p>
	<div class='center'>
		<a href='/works/'>
			<button class='btn'>My portfolio</button>
		</a>
	</div>

	<h2>Skills</h2>
	<div class='skills_grid'>
		<h3>Languages</h3>
		<div class='skills center'>
			<p>C</p>
			<p>C++</p>
			<p>Python</p>
			<p>Javascript</p>
			<p>VHDL</p>
		</div>
		<h3>Technologies</h3>
		<div class='skills center'>
			<p>FPGA</p>
			<p>Microcontrollers</p>
			<p>Linux</p>
		</div>
		<h3>Tools</h3>
		<div class='skills center'>
			<p>MATLAB</p>
			<p>Vivado</p>
			<p>Git</p>
		</div>
	</div>

	<h2>Work Experience</h2>
	<div class='education-timeline work-timeline'>
		<div class='experience work-experience experience--current'>
			<p class='experience__date'>2026</p>
			<p class='experience__title'>Student Research Assistant</p>
			<p class='experience__date'>Computer Networks Group, Paderborn University</p>
			<p class='experience__description'>Working on accelerating serverless LLM inference</p>
		</div>
	</div>

	<h2>Education</h2>
	<div class='education-timeline education-history'>
		<div class='experience education-experience experience--current'>
			<p class='experience__date'>2025 - 2027</p>
			<p class='experience__title'>Paderborn University</p>
			<p class='experience__detail'>Computer Engineering <span class='badge'>M.Sc</span></p>
		</div>
		<div class='experience education-experience experience--past'>
			<p class='experience__date'>2019 - 2023</p>
			<p class='experience__title'>National Institute of Technology, Trichy</p>
			<p class='experience__detail'>Electrical and Electronics Engineering <span class='badge'>B.Tech</span></p>
		</div>
	</div>

	<h2>Certificates</h2>
	<div>
		<h3>
			Tiny Machine Learning (TinyML) <span
				><a
					class='credential-link'
					href='https://credentials.edx.org/credentials/c42f617cc11e4695aefb017ee537ed38/'
					target='_blank'
					rel='noopener noreferrer'
					aria-label='Open Tiny Machine Learning credential'
					title='Open credential'
					><svg aria-hidden='true' viewBox='0 0 24 24'>
						<path d='M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3Z'></path>
						<path d='M5 5h6v2H7v10h10v-4h2v6H5V5Z'></path>
					</svg></a
				></span>
		</h3>
	</div>
	<div>
		<h3>
			Advanced Embedded Systems on Arm <span
				><a
					class='credential-link'
					href='https://credentials.edx.org/credentials/969685501e4b474e9bafb55c49894e51/'
					target='_blank'
					rel='noopener noreferrer'
					aria-label='Open Advanced Embedded Systems on Arm credential'
					title='Open credential'
					><svg aria-hidden='true' viewBox='0 0 24 24'>
						<path d='M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3Z'></path>
						<path d='M5 5h6v2H7v10h10v-4h2v6H5V5Z'></path>
					</svg></a
				></span>
		</h3>
	</div>
		
	</div>
</Layout>
